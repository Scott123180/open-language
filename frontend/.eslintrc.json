{
  "root": true,
  "env": {
    "browser": true,
    "es2020": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:react-hooks/recommended"
  ],
  "ignorePatterns": [
    "dist",
    "coverage",
    ".eslintrc.json"
  ],
  "parser": "@typescript-eslint/parser",
  "plugins": [
    "react-refresh"
  ],
  "rules": {
    "react-refresh/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/pages/Podcast*.tsx",
        "src/components/podcasts/**",
        "src/hooks/podcasts/**",
        "src/hooks/useConversationSummary.ts",
        "src/hooks/useSummaryLanguage.ts",
        "src/components/chat/Summary*.tsx",
        "src/services/podcastsApi.ts",
        "src/components/shared/ThemedSelect.tsx",
        "src/components/shared/useListboxNavigation.ts",
        "src/components/shared/ConfirmDialog.tsx",
        "src/components/settings/SelectField.tsx",
        "src/components/settings/LlmProviderFields.tsx",
        "src/components/chat/ConversationLevelControl.tsx"
      ],
      "excludedFiles": [
        "*.test.ts",
        "*.test.tsx",
        "*.test.utils.ts",
        "*.test.utils.tsx"
      ],
      "rules": {
        "max-lines-per-function": [
          "error",
          {
            "max": 20,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    }
  ]
}
