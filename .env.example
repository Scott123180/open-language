# Open Language — Environment Variables
# Copy this file to .env and fill in values before running

# SQLite database file path
OPEN_LANGUAGE_DB_PATH=~/.open-language/app.db

# Piper TTS voice model name (without path or extension)
OPEN_LANGUAGE_TTS_VOICE=es_ES-davefx-medium

# Directory containing .onnx Piper voice model files
OPEN_LANGUAGE_VOICE_DIR=~/.local/share/piper-voices

# Ollama server URL (local)
OPEN_LANGUAGE_OLLAMA_URL=http://localhost:11434

# Ollama model to use (must match output of `ollama list`)
OPEN_LANGUAGE_OLLAMA_MODEL=llama3.1:8b

# Whisper model size: tiny, base, small, medium, large-v2
OPEN_LANGUAGE_WHISPER_MODEL=base

# Whisper device: auto, cuda, cpu
OPEN_LANGUAGE_WHISPER_DEVICE=auto

# FastAPI host and port
OPEN_LANGUAGE_HOST=127.0.0.1
OPEN_LANGUAGE_PORT=8000
